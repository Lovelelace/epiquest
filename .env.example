# Copier ce fichier en .env pour le développement local : cp .env.example .env
# Ne jamais versionner le fichier .env. Le serveur et les scripts de apps/db le lisent
# automatiquement ; avec Docker Compose, les valeurs sont fournies par compose.yaml.

# Port HTTP de l'API NestJS
PORT=3000

# Connexion PostgreSQL (valeur adaptée au docker-compose de développement)
DATABASE_URL=postgres://epiquest:epiquest@localhost:5432/epiquest

# Origine du client web, autorisée par le CORS de l'API et de Socket.IO
WEB_ORIGIN=http://localhost:3001

# URL de l'API vue par le navigateur (client web Next.js). Next.js lit les variables
# NEXT_PUBLIC_* dans apps/web/.env.local ; sans valeur, http://localhost:3000 est utilisé.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Secret de signature des sessions : générer une valeur aléatoire longue
# (par exemple : openssl rand -hex 32). Ne jamais réutiliser la valeur de production.
SESSION_SECRET=change-me
