# Copier ce fichier en .env pour le développement local : cp .env.example .env
# Ne jamais versionner le fichier .env.

# Port HTTP du serveur
PORT=3000

# Connexion PostgreSQL (valeur adaptée au docker-compose de développement)
DATABASE_URL=postgres://epiquest:epiquest@localhost:5432/epiquest

# Secret de signature des sessions : générer une valeur aléatoire longue
# (par exemple : openssl rand -hex 32). Ne jamais réutiliser la valeur de production.
SESSION_SECRET=change-me
